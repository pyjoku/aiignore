# Example .aiignore for a developer working directory.
# Place in ~/projects/ or your code-root. Match = absolute block.

# Credentials and secrets — never read or write
.env
.env.*
**/*.env
**/*credentials*
**/*secrets*
**/id_rsa
**/id_ed25519
**/.ssh/**

# User's git config — never touch
~/.gitconfig
.git/config
