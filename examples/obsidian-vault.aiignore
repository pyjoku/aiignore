# Example .aiignore for an Obsidian vault.
# Place at the vault root. Match = absolute block (read + write).

# Block sensitive subtrees outright
patient/**
Finanzen/**
private-*/**
Tagebuch/**

# Never overwrite Obsidian internal state
.obsidian/workspace.json
.obsidian/workspaces.json

# For nuanced rules (readonly, writeonly, tool-restriction), use .aiattributes
