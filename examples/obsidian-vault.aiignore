# Example .aiignore for an Obsidian vault holding mixed-sensitivity content.
# Place this at the vault root.

# Block sensitive subtrees outright (both read and write).
patient/**
Finanzen/**
private-*/**
Tagebuch/**

# Allow agents to read family notes (e.g. for context), but never write.
[mode:write] Familie/**

# Never overwrite Obsidian's internal state files.
.obsidian/workspace.json
.obsidian/workspaces.json

# Allow agents to write into a designated workspace folder even if a parent
# pattern would otherwise block it. (Note: gitignore-style negation has limits —
# this only works if the parent folder isn't directly blocked.)
!_safe/**
